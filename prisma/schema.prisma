generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  password      String?
  role          String   @default("ADMIN")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders        Order[]
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  image       String?
  products    Product[]
  articles    Article[]
  videos      Video[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id                String            @id @default(cuid())
  slug              String            @unique
  name              String
  brand             String
  model             String
  price             Float
  currency          String            @default("KZT")
  oldPrice          Float?
  gallery           String            @default("[]")
  thumbnail         String?
  description       String
  shortDescription  String
  specifications    String?
  features          String?
  stock             Int               @default(0)
  rating            Float             @default(0)
  reviewCount       Int               @default(0)
  badge             String?
  colors            String?           @default("[]")
  tags              Tag[]
  attributes        ProductAttribute[]
  reviews           Review[]
  faq               ProductFaq[]
  relatedSlugs      String?           @default("[]")
  installationVideo String?
  manualPDF         String?
  firmware          String?
  ratingFloat       Float?            @default(0)
  availability      String            @default("in_stock")
  warrantyMonths    Int               @default(24)
  isPopular         Boolean           @default(false)
  isNew             Boolean           @default(false)
  categoryId        String?
  category          Category?         @relation(fields: [categoryId], references: [id])
  orderItems        OrderItem[]
  meta              String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model ProductAttribute {
  id        String  @id @default(cuid())
  productId String
  key       String
  value     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
}

model Review {
  id        String   @id @default(cuid())
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  avatar    String?
  rating    Int
  text      String
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ProductFaq {
  id        String  @id @default(cuid())
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  order     Int     @default(0)
}

model Article {
  id               String   @id @default(cuid())
  slug             String   @unique
  categoryId       String?
  category         Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title            String
  coverImage       String?
  content          String
  estimatedMinutes Int      @default(5)
  tags             String?  @default("[]")
  published        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Video {
  id          String   @id @default(cuid())
  slug        String   @unique
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title       String
  description String?
  youtubeId   String?
  videoUrl    String?
  thumbnail   String?
  tags        String? @default("[]")
  published   Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Download {
  id        String   @id @default(cuid())
  title     String
  fileUrl   String
  type      String
  size      String?
  createdAt DateTime @default(now())
}

model GalleryItem {
  id            String      @id @default(cuid())
  image         String
  title         String?
  order         Int         @default(0)
  isBeforeAfter Boolean     @default(false)
  beforeImage   String?
  afterImage    String?
  caseId        String?
  clientCase    ClientCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
}

model ClientCase {
  id          String        @id @default(cuid())
  title       String
  summary     String
  clientName  String?
  location    String?
  gallery     GalleryItem[]
  rating      Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  isGlobal  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id           String      @id @default(cuid())
  status       String      @default("PENDING")
  customerName String
  phone        String
  email        String?
  address      String?
  message      String?
  total        Float?
  items        OrderItem[]
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  source       String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  price     Float
  qty       Int
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id          String  @id @default(cuid())
  key         String  @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model SeoSetting {
  id          String   @id @default(cuid())
  path        String   @unique
  title       String
  description String?
  keywords    String?
  ogImage     String?
  noIndex     Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}
